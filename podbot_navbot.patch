+bool CCSSBotSensor::IsFriendly(CBaseEntity* entity) const
+{
+	if (podbot::PodBot().IsFreeForAll(GetBot<CCSSBot>()))
+	{
+		return false;
+	}
+
+	return CSimplePvPSensor<CCSSBot>::IsFriendly(entity);
