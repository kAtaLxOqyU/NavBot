diff --git a/configs/podbot/podbot.cfg b/configs/podbot/podbot.cfg
new file mode 100644
index 0000000..ae16ad8
--- /dev/null
+++ b/configs/podbot/podbot.cfg
@@ -0,0 +1,92 @@
+# podbot.cfg - PODBot-style settings for the CS:S bot (CS:S edition)
+# Same format as the original PODBot: '#' comment lines, "pb_name value" settings
+# and "pb add ..." commands. Removed (GoldSrc only): pb_wptfolder, pb_usespeech,
+# pb_spray, pb_latencybot, pb_welcomemsgs, pb_passwordkey, pb_password, "bind".
+# Admin access uses SourceMod admin flags instead of a password.
+
+# pb add [skill [personality [team [model [name]]]]]
+#   skill 0-100; personality 1 normal, 2 aggressive, 3 defensive; team 1 T, 2 CT, 5 auto
+# pb fillserver [skill [personality [team [model]]]]
+
+# Bot count limits (used by pb fillserver / auto add+kick). 0 disables auto fill.
+pb_minbots 0
+pb_maxbots 16
+pb_bot_quota_match 0
+pb_bot_join_team "ANY"
+pb_skin 5
+
+# Random skill range for bots added without an explicit skill.
+pb_minbotskill 95
+pb_maxbotskill 100
+
+# Seconds between perception checks.
+pb_timer_sound 0.5
+pb_timer_pickup 0.3
+pb_timer_grenade 0.5
+
+# Free for all: bots attack everybody, including teammates. The server also needs mp_friendlyfire 1.
+pb_ffa 0
+# Bots may fire at an enemy they only heard or saw a moment ago behind a wall. The chance per skill
+# level is SEEN_SHOOTTHRU / HEAR_SHOOTTHRU in botskill.cfg. Starts off in the CS:S edition (untested): set 1 to try it.
+pb_shootthruwalls 0
+pb_numfollowuser 5
+# CS:S edition: how long (seconds) bots follow a player after the "Follow Me" radio command
+pb_followtime 60
+pb_maxweaponpickup 10
+pb_mapstartbotdelay 10
+pb_autokill 0
+pb_autokilldelay 45
+pb_maxcamptime 30
+# CS:S edition: camp at spots taken from PODBot's waypoints (configs/navbot/podbot/hints/<map>.hint)
+pb_use_hints 1
+pb_jasonmode 0
+
+# 0 none, 1 [POD] prefix + (skill), 2 prefix only, 3 (skill) only
+pb_detailnames 1
+
+# Experience: how strongly bots avoid places where they were killed.
+pb_dangerfactor 2000
+
+pb_chat 1
+# CS:S edition chat tuning (new settings): chance in percent per event, cooldown in seconds
+pb_chat_killed_chance 30
+pb_chat_bomb_chance 40
+pb_chat_dead_chance 50
+pb_chat_reply_chance 25
+pb_chat_cooldown 8
+pb_radio 1
+# CS:S edition radio tuning (new settings): chance in percent per event, cooldown in seconds
+pb_radio_enemydown_chance 20
+pb_radio_takingfire_chance 30
+pb_radio_enemyspot_chance 25
+pb_radio_cooldown 10
+
+# Aim system: 1 inhuman turns, 2 constant angle velocity, 3 botaim1, 4 botaim2
+pb_aim_type 4
+pb_aim_spring_stiffness_x 13.0
+pb_aim_spring_stiffness_y 13.0
+pb_aim_damper_coefficient_x 0.22
+pb_aim_damper_coefficient_y 0.22
+pb_aim_deviation_x 2.0
+pb_aim_deviation_y 1.0
+pb_aim_influence_x_on_y 0.25
+pb_aim_influence_y_on_x 0.17
+# CS:S edition: multiplies both damper values (raise it to reduce overshoot after a flick)
+pb_aim_damping_scale 1.0
+pb_aim_offset_delay 1.2
+pb_aim_notarget_slowdown_ratio 0.5
+pb_aim_target_anticipation_ratio 2.2
+
+# Buy restrictions, one character per weapon in botweapons.cfg order (1 = restricted).
+# The last bit (shield) does not exist in CS:S and is ignored.
+pb_restrweapons "00000000000000000000000000"
+# vest, vest+helmet, flashbang, he, smoke, defuser, nightvision, primary ammo, secondary ammo
+pb_restrequipammo "000000000"
+
+pb add 100
+pb add 100
+pb add 100
+pb add 100
+pb add 100
+pb add 100
+pb add 100
