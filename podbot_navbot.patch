diff --git a/extension/podbot/podbot_aim.cpp b/extension/podbot/podbot_aim.cpp
new file mode 100644
index 0000000..e6022b5
--- /dev/null
+++ b/extension/podbot/podbot_aim.cpp
@@ -0,0 +1,108 @@
+#include "podbot_aim.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace podbot {
+
+namespace {
+constexpr float kRadToDeg = 57.29577951f;
+float Clamp(float v, float lo, float hi) { return std::max(lo, std::min(hi, v)); }
+}
+
+AimParams AimParams::FromSettings(const Settings& s)
+{
+	AimParams p;
+	p.type = s.GetInt("pb_aim_type", p.type);
+	p.stiffX = s.GetFloat("pb_aim_spring_stiffness_x", p.stiffX);
+	p.stiffY = s.GetFloat("pb_aim_spring_stiffness_y", p.stiffY);
+	p.dampX = s.GetFloat("pb_aim_damper_coefficient_x", p.dampX);
+	p.dampY = s.GetFloat("pb_aim_damper_coefficient_y", p.dampY);
+	p.dampScale = s.GetFloat("pb_aim_damping_scale", p.dampScale);
+	p.devX = s.GetFloat("pb_aim_deviation_x", p.devX);
+	p.devY = s.GetFloat("pb_aim_deviation_y", p.devY);
+	p.infXonY = s.GetFloat("pb_aim_influence_x_on_y", p.infXonY);
+	p.infYonX = s.GetFloat("pb_aim_influence_y_on_x", p.infYonX);
+	p.offsetDelay = s.GetFloat("pb_aim_offset_delay", p.offsetDelay);
+	p.noTargetSlowdown = s.GetFloat("pb_aim_notarget_slowdown_ratio", p.noTargetSlowdown);
+	p.anticipation = s.GetFloat("pb_aim_target_anticipation_ratio", p.anticipation);
+	return p;
+}
+
+float WrapDeg(float a)
+{
+	a = std::fmod(a + 180.0f, 360.0f);
+	if (a < 0.0f) a += 360.0f;
+	return a - 180.0f;
+}
+
+void Anticipate(const float pos[3], const float vel[3], float anticipation, float leadTime, float out[3])
+{
+	for (int i = 0; i < 3; ++i) out[i] = pos[i] + vel[i] * anticipation * leadTime;
+}
+
+void SkillAimOffset(const SkillBracket& b, Rng& rng, float out[3])
+{
+	out[0] = rng.Float(-b.offX, b.offX);
+	out[1] = rng.Float(-b.offY, b.offY);
+	out[2] = rng.Float(-b.offZ, b.offZ);
+}
+
+Angles SpringAim::Update(const Angles& desired, bool hasTarget, float maxTurn, float distance, float dt)
+{
+	if (!(dt > 0.0f)) return m_cur;
+	dt = std::min(dt, 0.1f);
+
+	if (m_p.type <= 1) {                      // "inhuman turns": snap to the target
+		m_cur = desired; m_cur.pitch = Clamp(m_cur.pitch, -89.0f, 89.0f); m_cur.yaw = WrapDeg(m_cur.yaw);
+		m_velP = m_velY = 0.0f;
+		return m_cur;
+	}
+
+	if (m_p.type == 2) {                      // constant angular velocity
+		float step = (maxTurn > 0.0f ? maxTurn : 720.0f) * dt;
+		float eP = desired.pitch - m_cur.pitch, eY = WrapDeg(desired.yaw - m_cur.yaw);
+		m_cur.pitch += Clamp(eP, -step, step);
+		m_cur.yaw = WrapDeg(m_cur.yaw + Clamp(eY, -step, step));
+		m_velP = m_velY = 0.0f;
+		return m_cur;
+	}
+
+	// spring-damper (types 3 and 4 share one model for now)
+	m_timer -= dt;
+	if (m_timer <= 0.0f) {                    // pick a new idle error offset (units)
+		m_devP = m_rng.Float(-m_p.devX, m_p.devX);
+		m_devY = m_rng.Float(-m_p.devY, m_p.devY);
+		m_timer = m_rng.Float(0.2f * m_p.offsetDelay, m_p.offsetDelay);
+	}
+	Angles target = desired;
+	if (!hasTarget && distance > 1.0f) {      // the error margin only applies when aiming at nothing
+		target.pitch += std::atan2(m_devP, distance) * kRadToDeg;
+		target.yaw += std::atan2(m_devY, distance) * kRadToDeg;
+	}
+
+	const float scale = hasTarget ? 1.0f : m_p.noTargetSlowdown;
+	const float dX = m_p.dampX * m_p.dampScale, dY = m_p.dampY * m_p.dampScale;
+	const float wP = m_p.stiffX * scale, wY = m_p.stiffY * scale;
+	const int steps = std::max(1, static_cast<int>(std::ceil(dt * 120.0f)));
+	const float h = dt / static_cast<float>(steps);
+
+	for (int i = 0; i < steps; ++i) {
+		float eP = target.pitch - m_cur.pitch;
+		float eY = WrapDeg(target.yaw - m_cur.yaw);
+		float aP = wP * wP * eP - 2.0f * dX * wP * m_velP;
+		float aY = wY * wY * eY - 2.0f * dY * wY * m_velY;
+		float aP2 = aP + m_p.infYonX * aY;     // yaw motion disturbs pitch
+		float aY2 = aY + m_p.infXonY * aP;     // pitch motion disturbs yaw
+		m_velP += aP2 * h;
+		m_velY += aY2 * h;
+		if (maxTurn > 0.0f) { m_velP = Clamp(m_velP, -maxTurn, maxTurn); m_velY = Clamp(m_velY, -maxTurn, maxTurn); }
+		m_cur.pitch += m_velP * h;
+		m_cur.yaw += m_velY * h;
+	}
+	m_cur.pitch = Clamp(m_cur.pitch, -89.0f, 89.0f);
+	m_cur.yaw = WrapDeg(m_cur.yaw);
+	return m_cur;
+}
+
+} // namespace podbot
diff --git a/extension/podbot/podbot_aim.h b/extension/podbot/podbot_aim.h
new file mode 100644
index 0000000..1ce9ddf
--- /dev/null
+++ b/extension/podbot/podbot_aim.h
@@ -0,0 +1,56 @@
+// podbot_aim.h - PODBot-style spring-damper aim controller (SDK independent).
+//
+// Interpretation of the pb_aim_* values (tune in game):
+//   each axis is a second-order system:  acc = w^2 * error - 2 * zeta * w * velocity
+//   w    = pb_aim_spring_stiffness_*   (rad/s: speed and oscillation frequency)
+//   zeta = pb_aim_damper_coefficient_* (< 1 overshoots like a human flick)
+//   x axis = vertical (pitch), y axis = horizontal (yaw), as in podbot.cfg.
+#pragma once
+#include "podbot_data.h"
+
+namespace podbot {
+
+struct Angles { float pitch = 0.0f, yaw = 0.0f; };   // degrees
+
+struct AimParams {
+	int   type = 4;                    // pb_aim_type: 1 snap, 2 constant velocity, 3/4 spring
+	float stiffX = 13.0f, stiffY = 13.0f;
+	float dampX = 0.22f,  dampY = 0.22f;
+	float dampScale = 1.0f;                    // pb_aim_damping_scale (CS:S edition): multiplies both damper values
+	float devX = 2.0f,    devY = 1.0f;          // idle error margin (game units)
+	float infXonY = 0.25f, infYonX = 0.17f;     // cross-axis disturbance
+	float offsetDelay = 1.2f;                   // seconds between new idle offsets
+	float noTargetSlowdown = 0.5f;              // speed ratio when aiming at nothing
+	float anticipation = 2.2f;                  // pb_aim_target_anticipation_ratio
+	static AimParams FromSettings(const Settings& s);
+};
+
+float WrapDeg(float a);   // to [-180, 180]
+
+// Predicted aim point: position + velocity * anticipation * leadTime.
+void Anticipate(const float pos[3], const float vel[3], float anticipation, float leadTime, float out[3]);
+
+// Random aim-point offset (units) for a skill bracket (AIM_OFFS_X/Y/Z), zero at skill 100.
+void SkillAimOffset(const SkillBracket& b, Rng& rng, float out[3]);
+
+class SpringAim {
+public:
+	explicit SpringAim(const AimParams& p = AimParams(), unsigned seed = 1) : m_p(p), m_rng(seed) {}
+	void Reset(const Angles& current) { m_cur = current; m_velP = m_velY = 0.0f; m_timer = 0.0f; m_devP = m_devY = 0.0f; }
+	// desired: ideal view angles. maxTurn: angular speed cap in deg/s (0 = none).
+	// distance: units to the aim point (turns the idle error margin into an angle).
+	Angles Update(const Angles& desired, bool hasTarget, float maxTurn, float distance, float dt);
+	// Follows the real view angles (recoil, snaps) while keeping the angular velocity.
+	void SyncCurrent(const Angles& a) { m_cur = a; }
+	const Angles& Current() const { return m_cur; }
+	float VelocityPitch() const { return m_velP; }
+	float VelocityYaw() const { return m_velY; }
+private:
+	AimParams m_p;
+	Rng m_rng;
+	Angles m_cur;
+	float m_velP = 0.0f, m_velY = 0.0f;
+	float m_timer = 0.0f, m_devP = 0.0f, m_devY = 0.0f;
+};
+
+} // namespace podbot
diff --git a/extension/podbot/podbot_commands.cpp b/extension/podbot/podbot_commands.cpp
new file mode 100644
index 0000000..8810d4a
--- /dev/null
+++ b/extension/podbot/podbot_commands.cpp
@@ -0,0 +1,50 @@
+#include NAVBOT_PCH_FILE
+#include <cstdlib>
+
+#include <extension.h>
+#include <manager.h>
+#include "podbot_manager.h"
+
+// pb add [skill [personality [team [model [name]]]]] | pb fillserver [skill [personality [team [model]]]] | pb reload
+CON_COMMAND(pb, "PODBot-style bot control: pb add|fillserver|reload")
+{
+	DECLARE_COMMAND_ARGS;
+
+	if (args.ArgC() < 2)
+	{
+		META_CONPRINT("Usage: pb add [skill [personality [team [model [name]]]]] | pb fillserver [skill [personality [team [model]]]] | pb reload\n");
+		return;
+	}
+
+	if (!extmanager->AreBotsSupported())
+	{
+		META_CONPRINT("Bot support is disabled! Check SourceMod logs for more information. \n");
+		return;
+	}
+
+	auto& pod = podbot::PodBot();
+	const char* verb = args[1];
+
+	if (strncasecmp(verb, "reload", 6) == 0)
+	{
+		pod.Load();
+	}
+	else if (strncasecmp(verb, "add", 3) == 0)
+	{
+		const int skill = args.ArgC() > 2 ? std::atoi(args[2]) : -1;
+		const int personality = args.ArgC() > 3 ? std::atoi(args[3]) : 0;
+		const std::string name = args.ArgC() > 6 ? args[6] : "";
+		const int team = args.ArgC() > 4 ? std::atoi(args[4]) : 0;
+		const int model = args.ArgC() > 5 ? std::atoi(args[5]) : 0;
+		pod.AddBot(skill, personality, name, team, model);
+	}
+	else if (strncasecmp(verb, "fillserver", 10) == 0)
+	{
+		pod.FillServer(args.ArgC() > 2 ? std::atoi(args[2]) : -1, args.ArgC() > 3 ? std::atoi(args[3]) : 0,
+			args.ArgC() > 4 ? std::atoi(args[4]) : 0, args.ArgC() > 5 ? std::atoi(args[5]) : 0);
+	}
+	else
+	{
+		META_CONPRINT("Unknown pb command.\n");
+	}
+}
diff --git a/extension/podbot/podbot_data.cpp b/extension/podbot/podbot_data.cpp
new file mode 100644
index 0000000..d8d2f8a
--- /dev/null
+++ b/extension/podbot/podbot_data.cpp
@@ -0,0 +1,386 @@
+#include "podbot_data.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <fstream>
+#include <set>
+
+namespace podbot {
+
+const char* const kWeaponNames[kNumWeapons] = {
+	"knife", "usp", "glock", "deagle", "p228", "elite", "fiveseven",
+	"m3", "xm1014", "mp5navy", "tmp", "p90", "mac10", "ump45",
+	"ak47", "sg552", "m4a1", "galil", "famas", "aug",
+	"scout", "awp", "g3sg1", "sg550", "m249", "shield" };
+
+namespace {
+
+std::string Trim(const std::string& s)
+{
+	size_t b = 0, e = s.size();
+	while (b < e && std::isspace(static_cast<unsigned char>(s[b]))) ++b;
+	while (e > b && std::isspace(static_cast<unsigned char>(s[e - 1]))) --e;
+	return s.substr(b, e - b);
+}
+
+std::string Upper(std::string s)
+{
+	for (auto& c : s) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+	return s;
+}
+
+std::string Lower(std::string s)
+{
+	for (auto& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+	return s;
+}
+
+// Reads a text file as lines; handles CRLF. Returns false if it cannot be opened.
+bool ReadLines(const std::string& path, std::vector<std::string>& out, std::string* err)
+{
+	std::ifstream f(path);
+	if (!f) { if (err) *err = "cannot open " + path; return false; }
+	std::string line;
+	while (std::getline(f, line)) {
+		if (!line.empty() && line.back() == '\r') line.pop_back();
+		out.push_back(line);
+	}
+	return true;
+}
+
+bool IsSkippable(const std::string& trimmed) { return trimmed.empty() || trimmed[0] == '#'; }
+
+// Splits on whitespace; a "quoted string" is one token (quotes removed).
+std::vector<std::string> Tokenize(const std::string& line)
+{
+	std::vector<std::string> t;
+	size_t i = 0, n = line.size();
+	while (i < n) {
+		while (i < n && std::isspace(static_cast<unsigned char>(line[i]))) ++i;
+		if (i >= n) break;
+		if (line[i] == '"') {
+			size_t j = line.find('"', i + 1);
+			if (j == std::string::npos) j = n;
+			t.push_back(line.substr(i + 1, j - i - 1));
+			i = j + 1;
+		} else {
+			size_t j = i;
+			while (j < n && !std::isspace(static_cast<unsigned char>(line[j]))) ++j;
+			t.push_back(line.substr(i, j - i));
+			i = j;
+		}
+	}
+	return t;
+}
+
+std::vector<std::string> ExtractQuoted(const std::string& line)
+{
+	std::vector<std::string> out;
+	size_t i = 0;
+	while ((i = line.find('"', i)) != std::string::npos) {
+		size_t j = line.find('"', i + 1);
+		if (j == std::string::npos) break;
+		out.push_back(Upper(line.substr(i + 1, j - i - 1)));
+		i = j + 1;
+	}
+	return out;
+}
+
+std::string Truncate(std::string s) { if (s.size() > kMaxChatLen) s.resize(kMaxChatLen); return s; }
+
+} // namespace
+
+// ------------------------------------------------------------------ Settings
+bool Settings::Load(const std::string& path, std::string* err)
+{
+	std::vector<std::string> lines;
+	if (!ReadLines(path, lines, err)) return false;
+	m_values.clear();   // a reload replaces the old settings and "pb add" lines
+	m_cmds.clear();
+	for (const auto& raw : lines) {
+		std::string line = Trim(raw);
+		if (IsSkippable(line)) continue;
+		auto tok = Tokenize(line);
+		if (tok.empty()) continue;
+		std::string head = Lower(tok[0]);
+		if (head.rfind("pb_", 0) == 0) {
+			m_values[head] = tok.size() > 1 ? tok[1] : "";
+		} else if (head == "pb" && tok.size() > 1) {
+			ConsoleCommand c;
+			c.verb = Lower(tok[1]);
+			c.args.assign(tok.begin() + 2, tok.end());
+			m_cmds.push_back(std::move(c));
+		}
+		// anything else (e.g. "bind") is client-side and ignored
+	}
+	return true;
+}
+
+bool Settings::Has(const std::string& key) const { return m_values.count(Lower(key)) > 0; }
+
+std::string Settings::GetString(const std::string& key, const std::string& def) const
+{
+	auto it = m_values.find(Lower(key));
+	return it == m_values.end() ? def : it->second;
+}
+
+int Settings::GetInt(const std::string& key, int def) const
+{
+	auto it = m_values.find(Lower(key));
+	return (it == m_values.end() || it->second.empty()) ? def : std::atoi(it->second.c_str());
+}
+
+float Settings::GetFloat(const std::string& key, float def) const
+{
+	auto it = m_values.find(Lower(key));
+	return (it == m_values.end() || it->second.empty()) ? def : std::strtof(it->second.c_str(), nullptr);
+}
+
+bool Settings::GetBool(const std::string& key, bool def) const
+{
+	auto it = m_values.find(Lower(key));
+	if (it == m_values.end()) return def;
+	std::string v = Lower(it->second);
+	return v == "1" || v == "true" || v == "yes" || v == "on";
+}
+
+// --------------------------------------------------------------- SkillTable
+bool SkillTable::Load(const std::string& path, std::string* err)
+{
+	std::vector<std::string> lines;
+	if (!ReadLines(path, lines, err)) return false;
+	m_b.clear();
+	for (const auto& raw : lines) {
+		std::string line = Trim(raw);
+		if (IsSkippable(line)) continue;
+		auto tok = Tokenize(line);
+		if (tok.size() < 2) continue;
+		std::string key = Upper(tok[0]);
+		float v = std::strtof(tok[1].c_str(), nullptr);
+		if (key == "MIN_DELAY") m_b.emplace_back();   // each bracket starts with MIN_DELAY
+		if (m_b.empty()) continue;
+		SkillBracket& b = m_b.back();
+		if (key == "MIN_DELAY") b.minDelay = v;
+		else if (key == "MAX_DELAY") b.maxDelay = v;
+		else if (key == "MIN_TURNSPEED") b.minTurn = v;
+		else if (key == "MAX_TURNSPEED") b.maxTurn = v;
+		else if (key == "AIM_OFFS_X") b.offX = v;
+		else if (key == "AIM_OFFS_Y") b.offY = v;
+		else if (key == "AIM_OFFS_Z") b.offZ = v;
+		else if (key == "HEADSHOT_ALLOW") b.headshot = static_cast<int>(v);
+		else if (key == "HEAR_SHOOTTHRU") b.hearThru = static_cast<int>(v);
+		else if (key == "SEEN_SHOOTTHRU") b.seenThru = static_cast<int>(v);
+	}
+	if (m_b.size() != 6) {
+		if (err) *err = "botskill.cfg: expected 6 skill brackets, found " + std::to_string(m_b.size());
+		return false;
+	}
+	static const int his[6] = { 19, 39, 59, 79, 99, 100 };
+	for (size_t i = 0; i < 6; ++i) { m_b[i].lo = i ? his[i - 1] + 1 : 0; m_b[i].hi = his[i]; }
+	return true;
+}
+
+const SkillBracket& SkillTable::ForSkill(int skill) const
+{
+	static const SkillBracket empty;
+	if (m_b.empty()) return empty;
+	skill = std::max(0, std::min(100, skill));
+	for (const auto& b : m_b) if (skill <= b.hi) return b;
+	return m_b.back();
+}
+
+// ---------------------------------------------------------------- NameList
+bool NameList::Load(const std::string& path, std::string* err)
+{
+	std::vector<std::string> lines;
+	if (!ReadLines(path, lines, err)) return false;
+	m_names.clear();
+	for (const auto& raw : lines) {
+		std::string line = Trim(raw);
+		if (!IsSkippable(line)) m_names.push_back(line);
+	}
+	if (m_names.size() < 9) {
+		if (err) *err = "botnames.txt: need at least 9 names";
+		return false;
+	}
+	return true;
+}
+
+std::string NameList::Format(const std::string& base, Personality p, int skill, int mode)
+{
+	const char* prefix = p == Personality::Aggressive ? "[P*D]" : p == Personality::Defensive ? "[P0D]" : "[POD]";
+	std::string pre, suf;
+	if (mode == 1 || mode == 2) pre = std::string(prefix) + " ";
+	if (mode == 1 || mode == 3) suf = " (" + std::to_string(skill) + ")";
+	size_t used = pre.size() + suf.size();
+	size_t room = kMaxNameLen > used ? kMaxNameLen - used : 0;
+	return pre + Trim(base.substr(0, room)) + suf;
+}
+
+// ----------------------------------------------------------- WeaponTables
+bool WeaponTables::Load(const std::string& path, std::string* err)
+{
+	std::vector<std::string> lines;
+	if (!ReadLines(path, lines, err)) return false;
+	m_rows.clear();
+	std::string section;
+	for (const auto& raw : lines) {
+		std::string line = Trim(raw);
+		if (IsSkippable(line)) continue;
+		if (line.front() == '[' && line.back() == ']') { section = Upper(line.substr(1, line.size() - 2)); continue; }
+		if (section.empty()) continue;
+		WeaponRow row{};
+		int n = 0;
+		size_t pos = 0;
+		while (pos <= line.size()) {
+			size_t comma = line.find(',', pos);
+			std::string cell = Trim(line.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos));
+			if (n < kNumWeapons) row[n] = std::atoi(cell.c_str());
+			++n;
+			if (comma == std::string::npos) break;
+			pos = comma + 1;
+		}
+		if (n != kNumWeapons) {
+			if (err) *err = "botweapons.cfg [" + section + "]: expected 26 entries, found " + std::to_string(n);
+			return false;
+		}
+		m_rows[section] = row;
+	}
+	for (const char* need : { "STANDARD", "NORMAL", "AGRESSIVE", "DEFENSIVE" }) {
+		if (!m_rows.count(need)) { if (err) *err = std::string("botweapons.cfg: missing section [") + need + "]"; return false; }
+	}
+	for (const char* pri : { "NORMAL", "AGRESSIVE", "DEFENSIVE" }) {
+		std::set<int> seen(m_rows[pri].begin(), m_rows[pri].end());
+		if (seen.size() != kNumWeapons || *seen.begin() != 0 || *seen.rbegin() != kNumWeapons - 1) {
+			if (err) *err = std::string("botweapons.cfg [") + pri + "]: not a permutation of 0..25";
+			return false;
+		}
+	}
+	return true;
+}
+
+bool WeaponTables::CanBuy(const std::string& table, int weapon, int team) const
+{
+	if (weapon < 0 || weapon >= kNumWeapons) return false;
+	auto it = m_rows.find(Upper(table));
+	if (it == m_rows.end()) it = m_rows.find("STANDARD");
+	if (it == m_rows.end()) return false;
+	int v = it->second[weapon];
+	return v == 2 || v == team;
+}
+
+const WeaponRow& WeaponTables::Ranking(Personality p) const
+{
+	const char* key = p == Personality::Aggressive ? "AGRESSIVE" : p == Personality::Defensive ? "DEFENSIVE" : "NORMAL";
+	return m_rows.at(key);
+}
+
+// ------------------------------------------------------------------ ChatDB
+bool ChatDB::Load(const std::string& path, std::string* err)
+{
+	std::vector<std::string> lines;
+	if (!ReadLines(path, lines, err)) return false;
+	m_killed.clear(); m_bomb.clear(); m_dead.clear(); m_unknown.clear(); m_replies.clear();
+	std::string section;
+	for (const auto& raw : lines) {
+		std::string line = Trim(raw);
+		if (IsSkippable(line)) continue;
+		if (line.front() == '[' && line.back() == ']') { section = Upper(line.substr(1, line.size() - 2)); continue; }
+		if (section == "REPLIES") {
+			if (line.rfind("@KEY", 0) == 0) { m_replies.push_back({ ExtractQuoted(line), {} }); }
+			else if (!m_replies.empty()) m_replies.back().answers.push_back(line);
+		}
+		else if (section == "KILLED") m_killed.push_back(line);
+		else if (section == "BOMBPLANT") m_bomb.push_back(line);
+		else if (section == "DEADCHAT") m_dead.push_back(line);
+		else if (section == "UNKNOWN") m_unknown.push_back(line);
+	}
+	if (m_killed.empty() || m_bomb.empty() || m_dead.size() < 9) {
+		if (err) *err = "botchat.txt: [KILLED]/[BOMBPLANT] need >=1 line and [DEADCHAT] >=9";
+		return false;
+	}
+	return true;
+}
+
+std::string ChatDB::Expand(const std::string& t, const ChatContext& c)
+{
+	std::string out;
+	for (size_t i = 0; i < t.size(); ++i) {
+		if (t[i] == '%' && i + 1 < t.size()) {
+			const std::string* rep = nullptr;
+			switch (t[i + 1]) {
+			case 'f': rep = &c.topFragger; break;
+			case 'm': rep = &c.mapName; break;
+			case 'r': rep = &c.timeLeft; break;
+			case 's': rep = &c.replyTo; break;
+			case 't': rep = &c.aliveMate; break;
+			case 'v': rep = &c.lastVictim; break;
+			}
+			if (rep) { out += *rep; ++i; continue; }
+		}
+		out += t[i];
+	}
+	return Truncate(out);
+}
+
+std::string ChatDB::Pick(const std::vector<std::string>& v, Rng& r, const ChatContext& c)
+{
+	return v.empty() ? std::string() : Expand(v[r.Index(v.size())], c);
+}
+
+std::string ChatDB::Reply(const std::string& playerText, Rng& r, const ChatContext& c) const
+{
+	std::string text = Upper(playerText);
+	for (const auto& g : m_replies) {
+		if (g.answers.empty()) continue;
+		for (const auto& kw : g.keywords)
+			if (!kw.empty() && text.find(kw) != std::string::npos)
+				return Expand(g.answers[r.Index(g.answers.size())], c);
+	}
+	return Pick(m_unknown, r, c);
+}
+
+// --------------------------------------------------------------- HintTable
+bool HintTable::Load(const std::string& path, std::string* err)
+{
+	std::vector<std::string> lines;
+	m_hints.clear();
+	if (!ReadLines(path, lines, err)) return false;
+	for (const auto& raw : lines) {
+		std::string line = Trim(raw);
+		if (IsSkippable(line)) continue;
+		auto tok = Tokenize(line);
+		if (tok.size() < 5) continue;
+		Hint h;
+		h.type = Lower(tok[0]);
+		for (int i = 0; i < 3; ++i) h.pos[i] = std::strtof(tok[1 + i].c_str(), nullptr);
+		h.team = std::atoi(tok[4].c_str());
+		for (int i = 0; i < 4 && 5 + static_cast<size_t>(i) < tok.size(); ++i) h.look[i] = std::strtof(tok[5 + i].c_str(), nullptr);
+		m_hints.push_back(std::move(h));
+	}
+	return true;
+}
+
+size_t HintTable::Count(const std::string& type) const
+{
+	size_t n = 0;
+	for (const auto& h : m_hints) if (h.type == type) ++n;
+	return n;
+}
+
+bool HintTable::Pick(const std::string& type, float x, float y, float maxDist, int team, Rng& rng, Hint& out) const
+{
+	std::vector<const Hint*> candidates;
+	for (const auto& h : m_hints) {
+		if (h.type != type) continue;
+		if (h.team != 0 && h.team != team) continue;
+		float dx = h.pos[0] - x, dy = h.pos[1] - y;
+		if (dx * dx + dy * dy <= maxDist * maxDist) candidates.push_back(&h);
+	}
+	if (candidates.empty()) return false;
+	out = *candidates[rng.Index(candidates.size())];
+	return true;
+}
+
+} // namespace podbot
diff --git a/extension/podbot/podbot_data.h b/extension/podbot/podbot_data.h
new file mode 100644
index 0000000..fbad89a
--- /dev/null
+++ b/extension/podbot/podbot_data.h
@@ -0,0 +1,140 @@
+// podbot_data.h - PODBot-style data layer for the CS:S remake.
+// Standalone C++17 (no Source SDK dependency) so it can be unit tested anywhere
+// and later dropped into the NavBot extension.
+#pragma once
+#include <array>
+#include <map>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace podbot {
+
+constexpr int kNumWeapons = 26;
+constexpr size_t kMaxChatLen = 127;   // Source chat limit
+constexpr size_t kMaxNameLen = 31;    // MAX_PLAYER_NAME_LENGTH (32) minus terminator
+
+// Weapon index -> CS buy alias, in PODBot's numbering (botweapons.cfg).
+extern const char* const kWeaponNames[kNumWeapons];
+
+enum class Personality { Normal = 1, Aggressive = 2, Defensive = 3 };
+
+class Rng {
+public:
+	explicit Rng(unsigned seed = std::random_device{}()) : m_(seed) {}
+	int Int(int lo, int hi) { return std::uniform_int_distribution<int>(lo, hi)(m_); }
+	float Float(float lo, float hi) { return lo >= hi ? lo : std::uniform_real_distribution<float>(lo, hi)(m_); }
+	size_t Index(size_t n) { return n ? std::uniform_int_distribution<size_t>(0, n - 1)(m_) : 0; }
+private:
+	std::mt19937 m_;
+};
+
+// ---- podbot.cfg (pb_* settings and "pb add"-style commands) ----
+struct ConsoleCommand { std::string verb; std::vector<std::string> args; };
+
+class Settings {
+public:
+	bool Load(const std::string& path, std::string* err = nullptr);
+	bool Has(const std::string& key) const;
+	std::string GetString(const std::string& key, const std::string& def = "") const;
+	int GetInt(const std::string& key, int def = 0) const;
+	float GetFloat(const std::string& key, float def = 0.0f) const;
+	bool GetBool(const std::string& key, bool def = false) const;
+	void Set(const std::string& key, const std::string& value) { m_values[key] = value; }
+	const std::vector<ConsoleCommand>& Commands() const { return m_cmds; }
+private:
+	std::map<std::string, std::string> m_values;
+	std::vector<ConsoleCommand> m_cmds;
+};
+
+// ---- botskill.cfg ----
+struct SkillBracket {
+	int lo = 0, hi = 0;                    // skill range this bracket covers
+	float minDelay = 0, maxDelay = 0;      // reaction time (seconds)
+	float minTurn = 0, maxTurn = 0;        // degrees per GoldSrc frame
+	float offX = 0, offY = 0, offZ = 0;    // aim offsets (units)
+	int headshot = 0, hearThru = 0, seenThru = 0; // percent
+};
+
+class SkillTable {
+public:
+	bool Load(const std::string& path, std::string* err = nullptr);
+	const SkillBracket& ForSkill(int skill) const;
+	size_t Size() const { return m_b.size(); }
+private:
+	std::vector<SkillBracket> m_b;
+};
+
+// ---- botnames.txt ----
+class NameList {
+public:
+	bool Load(const std::string& path, std::string* err = nullptr);
+	size_t Size() const { return m_names.size(); }
+	const std::string& Pick(Rng& rng) const { return m_names[rng.Index(m_names.size())]; }
+	// detailMode follows pb_detailnames: 0 none, 1 prefix+skill, 2 prefix, 3 skill.
+	static std::string Format(const std::string& base, Personality p, int skill, int detailMode);
+private:
+	std::vector<std::string> m_names;
+};
+
+// ---- botweapons.cfg ----
+using WeaponRow = std::array<int, kNumWeapons>;
+
+class WeaponTables {
+public:
+	bool Load(const std::string& path, std::string* err = nullptr);
+	// team: 0 = Terrorist, 1 = Counter-Terrorist. table: "STANDARD" or "AS".
+	bool CanBuy(const std::string& table, int weapon, int team) const;
+	// Weapon ids ordered from least to most desired for this personality.
+	const WeaponRow& Ranking(Personality p) const;
+private:
+	std::map<std::string, WeaponRow> m_rows;
+};
+
+// ---- botchat.txt ----
+struct ChatContext {
+	std::string topFragger, mapName, timeLeft, replyTo, aliveMate, lastVictim;
+};
+struct ReplyGroup { std::vector<std::string> keywords, answers; };
+
+class ChatDB {
+public:
+	bool Load(const std::string& path, std::string* err = nullptr);
+	const std::vector<std::string>& Killed() const { return m_killed; }
+	const std::vector<std::string>& BombPlant() const { return m_bomb; }
+	const std::vector<std::string>& DeadChat() const { return m_dead; }
+	const std::vector<std::string>& Unknown() const { return m_unknown; }
+	const std::vector<ReplyGroup>& Replies() const { return m_replies; }
+
+	std::string PickKilled(Rng& r, const ChatContext& c) const { return Pick(m_killed, r, c); }
+	std::string PickBombPlant(Rng& r, const ChatContext& c) const { return Pick(m_bomb, r, c); }
+	std::string PickDeadChat(Rng& r, const ChatContext& c) const { return Pick(m_dead, r, c); }
+	// Answer to something a player typed: first matching keyword group, else [UNKNOWN].
+	std::string Reply(const std::string& playerText, Rng& r, const ChatContext& c) const;
+	static std::string Expand(const std::string& tmpl, const ChatContext& c);
+private:
+	static std::string Pick(const std::vector<std::string>& v, Rng& r, const ChatContext& c);
+	std::vector<std::string> m_killed, m_bomb, m_dead, m_unknown;
+	std::vector<ReplyGroup> m_replies;
+};
